# Copy to .env (git-ignored) and fill in. Never commit real keys.

# anthropic | openai
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional. Defaults: claude-sonnet-5 (anthropic) / gpt-4o-mini (openai)
LLM_MODEL=
# Optional, e.g. an OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_TIMEOUT=120

# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite target database that uploads are loaded into (created with demo data if missing)
TARGET_DB_PATH=data/target.db
