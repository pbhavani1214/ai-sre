# Copy to .env (git-ignored) and fill in. Never commit real keys.

# anthropic | openai
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional. Defaults: claude-sonnet-5 (anthropic) / gpt-4o-mini (openai)
LLM_MODEL=
# Optional, e.g. an OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_TIMEOUT=120

# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Folder whose SQLite files (*.db, *.sqlite, *.sqlite3) are the databases users can choose from.
# The demo databases crm.db and sales.db are created in it if missing.
TARGET_DB_DIR=data/databases
# Optional: the default database (used when a request names none). Defaults to TARGET_DB_DIR/crm.db.
# TARGET_DB_PATH=
